#!name=iOS Location Spoofer
#!desc=拦截 Apple 定位服务器回应，替换坐标。在 Surge 模块详情页编辑经纬度、精度等参数。
#!homepage=https://github.com/mekos2772/ios-location-spoofer
#!argument=lat=40.747565&lon=-111.890969&hacc=39&vacc=1000&alt=530

[Script]
iOS Location Spoofer = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/mekos2772/ios-location-spoofer/main/location-spoofer.js,argument=mode=response&latitude=[[arg.lat]]&longitude=[[arg.lon]]&horizontalAccuracy=[[arg.hacc]]&verticalAccuracy=[[arg.vacc]]&altitude=[[arg.alt]]&debug=false

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
